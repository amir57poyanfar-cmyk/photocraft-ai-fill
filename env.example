# Copy to .env and fill in. .env is git-ignored; config.json overrides it.
GEMINI_API_KEY=

# PhotoCraft control socket
PHOTOCRAFT_HOST=127.0.0.1
PHOTOCRAFT_PORT=8765

# 64 character hex token PhotoCraft expects in the auth handshake.
# Leave blank to auto-generate one on first run (see config.json).
PHOTOCRAFT_CONTROL_TOKEN=

# Optional model overrides
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGEN_MODEL=imagen-4.0-generate-001

# Optional timeouts (seconds)
PHOTOCRAFT_CONNECT_TIMEOUT=5
PHOTOCRAFT_RESPONSE_TIMEOUT=120
